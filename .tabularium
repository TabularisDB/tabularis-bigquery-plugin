{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "name": "bigquery",
  "version": "0.2.0",
  "description": "Google BigQuery driver for Tabularis with multi-project browsing, cancellable paged queries, sessions and transactions, query plans, GoogleSQL, materialized views, routine management, typed row editing and cost controls.",
  "category": "database",
  "tags": ["driver", "bigquery", "google-cloud", "gcp", "sql", "googlesql", "analytics", "data-warehouse", "database-driver"],
  "kind": "driver",
  "engine": "bigquery",
  "explain_parsers": [
    {
      "engine": "bigquery",
      "format": "bigquery-job-json",
      "label": "BigQuery job plan (JSON)",
      "module": "explain/dist/index.iife.js"
    }
  ],
  "paradigms": ["relational", "columnar"],
  "license": "Apache-2.0",
  "readme": "README.md",
  "min_runtime_version": "0.29.0",
  "homepage": "https://github.com/TabularisDB/tabularis-bigquery-plugin",
  "documentation_url": "https://github.com/TabularisDB/tabularis-bigquery-plugin#readme",
  "support": {
    "issues_url": "https://github.com/TabularisDB/tabularis-bigquery-plugin/issues"
  },
  "default_port": 443,
  "default_username": "",
  "executable": "bigquery-plugin",
  "color": "#4285F4",
  "icon": "cloud",
  "connection_fields": {
    "host": {"hidden": true},
    "port": {"hidden": true},
    "username": {"hidden": true},
    "password": {"hidden": true},
    "database": {
      "label": "GCP Project ID",
      "placeholder": "my-data-project"
    }
  },
  "ui_extensions": [
    {
      "slot": "connection-modal.extra_fields",
      "module": "ui/dist/connection-fields.js",
      "order": 10,
      "driver": "bigquery"
    }
  ],
  "capabilities": {
    "schemas": true,
    "views": true,
    "materialized_views": true,
    "routines": true,
    "routine_management": true,
    "triggers": false,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "connection_string": false,
    "identifier_quote": "`",
    "sql_dialect": "generic",
    "alter_primary_key": true,
    "alter_column": true,
    "create_foreign_keys": true,
    "manage_tables": true,
    "supports_ssl": false,
    "explain": true,
    "readonly": false,
    "serial_type": "",
    "auto_increment_keyword": "",
    "inline_pk": false,
    "column_comments": true
  },
  "type_mappings": {
    "INTEGER": "INT64",
    "BIGINT": "INT64",
    "SERIAL": "INT64",
    "REAL": "FLOAT64",
    "DOUBLE": "FLOAT64",
    "DECIMAL": "NUMERIC",
    "BOOLEAN": "BOOL",
    "TEXT": "STRING",
    "VARCHAR": "STRING",
    "UUID": "STRING",
    "BLOB": "BYTES",
    "JSON": "JSON",
    "DATE": "DATE",
    "TIME": "TIME",
    "DATETIME": "DATETIME",
    "TIMESTAMP": "TIMESTAMP"
  },
  "data_types": [
    {"name": "INT64", "category": "numeric", "requires_length": false, "requires_precision": false},
    {"name": "FLOAT64", "category": "numeric", "requires_length": false, "requires_precision": false},
    {"name": "NUMERIC", "category": "numeric", "requires_length": false, "requires_precision": false},
    {"name": "BIGNUMERIC", "category": "numeric", "requires_length": false, "requires_precision": false},
    {"name": "STRING", "category": "string", "requires_length": false, "requires_precision": false},
    {"name": "BYTES", "category": "binary", "requires_length": false, "requires_precision": false},
    {"name": "BOOL", "category": "other", "requires_length": false, "requires_precision": false},
    {"name": "DATE", "category": "date", "requires_length": false, "requires_precision": false},
    {"name": "TIME", "category": "date", "requires_length": false, "requires_precision": false},
    {"name": "DATETIME", "category": "date", "requires_length": false, "requires_precision": false},
    {"name": "TIMESTAMP", "category": "date", "requires_length": false, "requires_precision": false},
    {"name": "INTERVAL", "category": "date", "requires_length": false, "requires_precision": false},
    {"name": "JSON", "category": "json", "requires_length": false, "requires_precision": false},
    {"name": "GEOGRAPHY", "category": "spatial", "requires_length": false, "requires_precision": false},
    {"name": "ARRAY", "category": "other", "requires_length": false, "requires_precision": false},
    {"name": "STRUCT", "category": "other", "requires_length": false, "requires_precision": false},
    {"name": "RANGE", "category": "other", "requires_length": false, "requires_precision": false}
  ]
}
